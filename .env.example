# Copy to .env for local development (`cp .env.example .env`). Never commit real secrets.
# `docker compose up` sets its own values and does not need this file.

# ---------------------------------------------------------------- API (apps/api)

# Postgres connection string. Locally: the docker compose `db` service.
# Production: Neon pooled connection string with ?sslmode=require.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fittrack

# Secret used to sign session tokens. Required (≥ 32 chars) when NODE_ENV=production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Session token lifetime (vercel/ms format, e.g. 30d, 12h).
JWT_EXPIRES_IN=30d

# Comma-separated browser origins allowed to call the API. One leading wildcard label is
# allowed, e.g. https://*--my-site.netlify.app. Native apps send no Origin and are always allowed.
CORS_ORIGINS=http://localhost:8081,http://localhost:8080

# development | test | production
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Postgres pool size (keep small on free tiers).
DATABASE_POOL_MAX=5

# Apply migrations and sync the exercise catalog when the server starts.
RUN_MIGRATIONS=true

# Hours before "Try the demo" sandbox accounts are deleted.
DEMO_TTL_HOURS=24

# Rate limits (per client IP).
RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_MINUTE=20
DEMO_RATE_LIMIT_PER_HOUR=30

# Database used by the API integration tests (`npm test`).
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/fittrack_test

# Database used by the Playwright e2e suite (`npm run test:e2e`).
E2E_DATABASE_URL=postgres://postgres:postgres@localhost:5432/fittrack_e2e

# ---------------------------------------------------------------- App (apps/web)
# EXPO_PUBLIC_* values are inlined into the JS bundle at build time — never put secrets here.

# API base URL. Local web: http://localhost:4000. On a phone (Expo Go / dev build) use your
# computer's LAN IP, e.g. http://192.168.1.20:4000. Production: your Render URL.
EXPO_PUBLIC_API_URL=http://localhost:4000

# Set to "mock" to force simulated health data on iOS/Android (Expo Go always uses it).
EXPO_PUBLIC_HEALTH_PROVIDER=
